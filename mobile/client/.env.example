# Copy to .env and adjust. Expo exposes EXPO_PUBLIC_* to the app bundle.
# Production API (same base the web client uses):
EXPO_PUBLIC_BACKEND_URL=https://api.lifebookz.com/api/v1
# Local backend dev examples: Android http://10.0.2.2:5000 — iOS http://localhost:5000
# Cross-portal handoffs (payment / live session), same as the web client's
# VITE_PAYMENT_URL / VITE_SESSION_URL.
EXPO_PUBLIC_PAYMENT_URL=https://payment.lifebookz.com
EXPO_PUBLIC_SESSION_URL=https://session.lifebookz.com

# the wss:// execute-api invoke URL, e.g.  wss://abc123.execute-api.us-east-1.amazonaws.com/prod
EXPO_PUBLIC_WS_URL= 
